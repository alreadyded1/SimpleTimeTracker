[Unit]
Description=CabbyTime Time Tracker
After=network.target

[Service]
Type=simple
User=cabbytime
Group=cabbytime
WorkingDirectory=/opt/cabbytime/backend
ExecStart=/opt/cabbytime/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment=DB_DIR=/opt/cabbytime/data

[Install]
WantedBy=multi-user.target
